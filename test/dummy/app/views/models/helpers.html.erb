<p><%= truncate("Hello wonderful world", length: 10) %></p>
<%= simple_format("one\ntwo\n\n<b>three</b>") %>
<p><%= number_with_delimiter(1234567) %> <%= number_with_delimiter(-1234.5) %></p>
<p id="<%= dom_id(@post) %>"></p>
<%= badge("<new>") %>
<p><%= number_to_currency(1234.5) %> <%= number_to_currency(-5, unit: "€", precision: 0) %></p>
<p><%= time_ago_in_words(@post.created_at) %></p>
<%= link_to post_path(@post), class: "card" do %><strong><%= @post.title %></strong><% end %>
<%= stylesheet_link_tag "style", media: "all" %>
<%= javascript_include_tag "https://cdn.example.com/x.js", defer: true %>
<%= image_tag "logo.png", alt: "Logo" %>
<%= favicon_link_tag "favicon.svg" %>
<%= favicon_link_tag "/apple.png", rel: "apple-touch-icon", sizes: "180x180" %>
